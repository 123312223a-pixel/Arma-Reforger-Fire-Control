{
  "name": "arma-reforger-fire-control",
  "private": true,
  "version": "3.6.0",
  "type": "module",
  "description": "Arma Reforger Fire Control Windows Tauri 2",
  "scripts": {
    "dev:web": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build:web": "vite build",
    "preview:web": "vite preview --port 4173",
    "tauri": "tauri",
    "dev": "tauri dev",
    "icon": "tauri icon src-tauri/icons/app-icon.svg",
    "build": "tauri build",
    "check": "node scripts/verify.mjs",
    "configure:updates": "node scripts/configure-updater.mjs",
    "build:updates": "node scripts/require-updater.mjs && tauri build --features signed-updates --config src-tauri/tauri.updater.conf.json",
    "release:verify": "node scripts/verify.mjs && node scripts/require-updater.mjs",
    "version:set": "node scripts/set-version.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0"
  }
}
